# Токен бота: Developer Portal → Bot → Reset Token
DISCORD_TOKEN=сюда_токен_бота

# ID приложения: Developer Portal → General Information → Application ID
CLIENT_ID=сюда_id_приложения

# Необязательно: ID твоего сервера (ПКМ по серверу → «Копировать ID сервера»,
# нужен режим разработчика). С ним команды регистрируются мгновенно,
# без него — глобально, до часа.
GUILD_ID=

# Порт keep-alive сервера. На Render НЕ менять — он сам выдаст PORT.
PORT=10000
